# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# XKIRO_API_KEY: Optional API key for xKiro Multi-Specialist Gateway.
XKIRO_API_KEY=""

# UNOROUTER_API_KEY: Optional API key for UNOROUTER model access.
UNOROUTER_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# CLOUDFLARE_TURNSTILE_SECRET_KEY: Optional secret key for Cloudflare Turnstile bot verification
CLOUDFLARE_TURNSTILE_SECRET_KEY=""
CLOUDFLARE_TURNSTILE_SITE_KEY=""

# TRUST_PROXY_HOPS: Exact hop count for reverse proxy behind Cloud Run / Nginx (defaults to 1)
TRUST_PROXY_HOPS="1"

# ALLOWED_ORIGINS: Comma-separated extra allowed origins for CORS & Anti-CSRF
ALLOWED_ORIGINS=""

